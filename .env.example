# Port the HTTP server listens on
PORT=3000

# Public base URL of the deployment, without trailing slash.
# Used to build the webcal:// / https:// subscription links and the iCalendar UIDs.
PUBLIC_BASE_URL=https://hertha-kalender.example.de

# How long fixture data is cached before refetching from OpenLigaDB (minutes)
CACHE_TTL_MINUTES=30

# Set to "1" behind a reverse proxy (nginx, Traefik, Caddy) so the correct
# protocol/host is detected from X-Forwarded-* headers.
TRUST_PROXY=0
